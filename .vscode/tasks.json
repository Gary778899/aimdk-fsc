{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "机器人：下载采集数据",
            "type": "process",
            "command": "bash",
            "args": [
                "-c",
                "ssh agi@10.0.1.41 'if [ -d /home/agi/aimdk-fsc/data ]; then exit 0; elif [ ! -e /home/agi/aimdk-fsc/data ]; then exit 3; else echo \"数据路径不是目录\" >&2; exit 1; fi'\nstatus=$?\nif [ \"$status\" -eq 3 ]; then\n    printf '无数据可下载：机器人 data 目录不存在。\\n'\n    exit 0\nelif [ \"$status\" -ne 0 ]; then\n    exit \"$status\"\nfi\nexec rsync -az --checksum --itemize-changes --human-readable --info=progress2 agi@10.0.1.41:/home/agi/aimdk-fsc/data/ \"$1\"",
                "download-data",
                "${workspaceFolder}/data/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：下载日志",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--checksum",
                "--itemize-changes",
                "--human-readable",
                "--info=progress2",
                "agi@10.0.1.41:/home/agi/aimdk-fsc/log/",
                "${workspaceFolder}/log/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：预览同步",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--relative",
                "--dry-run",
                "--delete",
                "--itemize-changes",
                "--human-readable",
                "--exclude=.git/",
                "--exclude=.vscode/",
                "--exclude=.agents/",
                "--exclude=.codex/",
                "--exclude=.aws/",
                "--exclude=build/",
                "--exclude=install/",
                "--exclude=exports/",
                "--exclude=/data/",
                "--exclude=log/",
                "--exclude=/docs/",
                "--exclude=.venv/",
                "--exclude=build-humble/",
                "--exclude=install-humble/",
                "--exclude=log-humble/",
                "--exclude=.venv-humble/",
                "--exclude=prebuilt_*/",
                "--exclude=__pycache__/",
                "--exclude=*.pyc",
                "--exclude=*.md",
                "--exclude=.pytest_cache/",
                "--exclude=/src/locomotion_wrapper/",
                "--rsync-path=mkdir -p /home/agi/aimdk-fsc/ && rsync",
                "${workspaceFolder}/overlay/./src/",
                "${workspaceFolder}/./scripts/",
                "${workspaceFolder}/./docker/",
                "agi@10.0.1.41:/home/agi/aimdk-fsc/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：推送工作区",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--relative",
                "--itemize-changes",
                "--human-readable",
                "--info=progress2",
                "--delete",
                "--exclude=.git/",
                "--exclude=.vscode/",
                "--exclude=.agents/",
                "--exclude=.codex/",
                "--exclude=.aws/",
                "--exclude=build/",
                "--exclude=install/",
                "--exclude=exports/",
                "--exclude=/data/",
                "--exclude=log/",
                "--exclude=/docs/",
                "--exclude=.venv/",
                "--exclude=build-humble/",
                "--exclude=install-humble/",
                "--exclude=log-humble/",
                "--exclude=.venv-humble/",
                "--exclude=prebuilt_*/",
                "--exclude=__pycache__/",
                "--exclude=*.pyc",
                "--exclude=*.md",
                "--exclude=.pytest_cache/",
                "--exclude=/src/locomotion_wrapper/",
                "--rsync-path=mkdir -p /home/agi/aimdk-fsc/ && rsync",
                "${workspaceFolder}/overlay/./src/",
                "${workspaceFolder}/./scripts/",
                "${workspaceFolder}/./docker/",
                "agi@10.0.1.41:/home/agi/aimdk-fsc/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        }
    ]

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "机器人：推送轨迹",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--checksum",
                "--itemize-changes",
                "--human-readable",
                "--info=progress2",
                "--rsync-path=mkdir -p /home/agi/aimdk-fsc/data/trajectories/ && rsync",
                "${workspaceFolder}/data/trajectories/",
                "${input:robotHost}:/home/agi/aimdk-fsc/data/trajectories/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：下载采集数据",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/download_collection.sh",
                "${workspaceFolder}/data",
                "${input:robotHost}",
                "${input:collectionTrial}"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：下载日志",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--checksum",
                "--relative",
                "--ignore-missing-args",
                "--itemize-changes",
                "--human-readable",
                "--info=progress2",
                "${input:robotHost}:/home/agi/aimdk-fsc/./log/",
                "${input:robotHost}:/home/agi/aimdk-fsc/./realsense_ws/log/",
                "${workspaceFolder}/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：预览全量清理",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/robot_cleanup.py",
                "--host",
                "${input:robotHost}",
                "--all"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：执行全量清理",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/robot_cleanup.py",
                "--host",
                "${input:robotHost}",
                "--all",
                "--execute"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：预览同步",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--relative",
                "--dry-run",
                "--delete",
                "--itemize-changes",
                "--human-readable",
                "--exclude=.git/",
                "--exclude=.vscode/",
                "--exclude=.agents/",
                "--exclude=.codex/",
                "--exclude=.aws/",
                "--exclude=build/",
                "--exclude=install/",
                "--exclude=exports/",
                "--exclude=/data/",
                "--exclude=log/",
                "--exclude=/docs/",
                "--exclude=.venv/",
                "--exclude=build-humble/",
                "--exclude=install-humble/",
                "--exclude=log-humble/",
                "--exclude=.venv-humble/",
                "--exclude=prebuilt_*/",
                "--exclude=__pycache__/",
                "--exclude=*.pyc",
                "--exclude=*.md",
                "--exclude=.pytest_cache/",
                "--exclude=/src/locomotion_wrapper/",
                "--rsync-path=mkdir -p /home/agi/aimdk-fsc/ && rsync",
                "${workspaceFolder}/overlay/./src/",
                "${workspaceFolder}/./scripts/",
                "${workspaceFolder}/./docker/",
                "${input:robotHost}:/home/agi/aimdk-fsc/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        },
        {
            "label": "机器人：推送工作区",
            "type": "process",
            "command": "rsync",
            "args": [
                "-az",
                "--relative",
                "--itemize-changes",
                "--human-readable",
                "--info=progress2",
                "--delete",
                "--exclude=.git/",
                "--exclude=.vscode/",
                "--exclude=.agents/",
                "--exclude=.codex/",
                "--exclude=.aws/",
                "--exclude=build/",
                "--exclude=install/",
                "--exclude=exports/",
                "--exclude=/data/",
                "--exclude=log/",
                "--exclude=/docs/",
                "--exclude=.venv/",
                "--exclude=build-humble/",
                "--exclude=install-humble/",
                "--exclude=log-humble/",
                "--exclude=.venv-humble/",
                "--exclude=prebuilt_*/",
                "--exclude=__pycache__/",
                "--exclude=*.pyc",
                "--exclude=*.md",
                "--exclude=.pytest_cache/",
                "--exclude=/src/locomotion_wrapper/",
                "--rsync-path=mkdir -p /home/agi/aimdk-fsc/ && rsync",
                "${workspaceFolder}/overlay/./src/",
                "${workspaceFolder}/./scripts/",
                "${workspaceFolder}/./docker/",
                "${input:robotHost}:/home/agi/aimdk-fsc/"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "focus": true
            }
        }
    ],
    "inputs": [
        {
            "id": "collectionTrial",
            "type": "promptString",
            "description": "输入 all 下载全部，或输入 任务/会话 下载单次示教",
            "default": "all"
        },
        {
            "id": "robotHost",
            "type": "pickString",
            "description": "选择机器人 SSH 连接：10.0.1.41（有线）或 192.168.31.149（无线）",
            "options": [
                "agi@10.0.1.41",
                "agi@192.168.31.149"
            ],
            "default": "agi@10.0.1.41"
        }
    ]
}
